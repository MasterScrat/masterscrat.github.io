---
interface Props {
  kind?: string; // tag shown above the title: "Project" (default), "Work", "Post"…
  href: string;
  title: string;
  meta: string;
  text: string;
  image?: string;
  draft?: boolean; // shown with a striped background (dev only, drafts aren't published)
  progress?: 'stub' | 'sourced' | 'writing' | 'done';
}
const { kind = 'Project', href, title, meta, text, image, draft = false, progress = 'done' } = Astro.props;
// Work-in-progress badges, only in `npm run dev`.
const showStatus = import.meta.env.DEV && (draft || progress !== 'done');
---
<article class:list={["tile", { "tile-draft": draft }]}>
  {image && <img src={image} alt="" loading="lazy" />}
  <p class={`tile-kind tile-kind-${kind.toLowerCase()}`}>{kind}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="tile-text">{text}</p>
  <footer>
    <small>{meta}</small>
    {showStatus && (
      <small class="tile-status">
        {draft && <span class="status status-draft">Draft</span>}
        {progress !== 'done' && <span class={`status status-${progress}`}>{progress}</span>}
      </small>
    )}
  </footer>
</article>
