---
interface Props {
  kind?: string; // tag shown above the title: "Project" (default), "Work", "Post"…
  href: string;
  title: string;
  meta?: string; // e.g. a post's date
  text: string;
  image?: string;
  draft?: boolean; // shown with a striped background (dev only, drafts aren't published)
}
const { kind = 'Project', href, title, meta, text, image, draft = false } = Astro.props;
// Draft badge, only in `npm run dev` (drafts aren't published).
const showStatus = import.meta.env.DEV && draft;
---
<article class:list={["tile", { "tile-draft": draft }]}>
  {image && <img src={image} alt="" loading="lazy" />}
  <p class={`tile-kind tile-kind-${kind.toLowerCase()}`}>{kind}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="tile-text">{text}</p>
  {(meta || showStatus) && <footer>
    <small>{meta}</small>
    {showStatus && (
      <small class="tile-status">
        <span class="status status-draft">Draft</span>
      </small>
    )}
  </footer>}
</article>
