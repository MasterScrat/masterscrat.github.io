---
import '@picocss/pico/css/pico.min.css';
import '../styles/global.css';

interface Props { title?: string; description?: string }
const siteTitle = 'Florian Laurent';
const { title, description = 'Personal website of Florian Laurent.' } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
// Highlight the current section; posts live under /YYYY/... so count them as Blog.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/'
    ? path === '/' || path === '/index.html'
    : path.startsWith(href.replace(/\/$/, '')) || (href === '/blog' && /^\/\d{4}\//.test(path));
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <meta name="description" content={description}>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E05E523KWW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E05E523KWW');
    </script>
  </head>
  <body>
    <header class="container">
      <nav>
        <ul><li><a href="/" class="site-title">{siteTitle}</a></li></ul>
        <ul>
          {nav.map(({ href, label }) => (
            <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container">
      <nav>
        <ul>
          <li><a href="https://github.com/MasterScrat">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/florianlaurent/">LinkedIn</a></li>
          <li><a href="https://twitter.com/MasterScrat">Twitter</a></li>
          <li><a href="https://www.reddit.com/user/MasterScrat/">Reddit</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
