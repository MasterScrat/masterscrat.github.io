---
import '../styles/global.css';

interface Props { title?: string }
const { title } = Astro.props;
const siteTitle = 'Florian Laurent';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title ?? siteTitle}</title>
    <meta name="description" content="Personal website of Florian Laurent.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E05E523KWW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E05E523KWW');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper">
        <nav class="site-nav">
          <a class="page-link" href="/">about me</a>
          <a class="page-link" href="/blog">blog</a>
        </nav>
      </div>
    </header>

    <div class="page-content">
      <div class="wrapper">
        <slot />
      </div>
    </div>
  </body>
</html>
