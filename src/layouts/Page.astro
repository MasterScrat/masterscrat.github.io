---
import Base from './Base.astro';

// Layout for Markdown pages (e.g. About). Same full width as the other nav
// sections; the page title only goes in <title>, the nav shows where you are.
// An optional `image` in the frontmatter is shown in a column on the right.
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} heading={frontmatter.title} description={frontmatter.description}>
  {frontmatter.image ? (
    <div class="with-aside">
      <article><slot /></article>
      <img src={frontmatter.image} alt={frontmatter.imageAlt ?? ""} />
    </div>
  ) : (
    <article><slot /></article>
  )}
</Base>
