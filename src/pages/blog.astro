---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, formatDate, excerpt } from '../lib/posts';

const posts = await getPosts();
---
<Base title="Blog">
  <h1>Blog</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <small class="meta">{formatDate(post.data.date)}</small>
        <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
        <p>{excerpt(post)}</p>
      </li>
    ))}
  </ul>
</Base>
