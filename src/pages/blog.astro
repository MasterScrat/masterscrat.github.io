---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, formatDate } from '../lib/posts';

const posts = await getPosts();
const wordCount = (text = '') => text.split(/\s+/).filter(Boolean).length;
---
<Base title="blog">
  <div class="header-bar">
    <h1>blog</h1>
  </div>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h2><a class="post-list-title" href={postUrl(post)}>{post.data.title}</a></h2>
        <p class="post-meta">{formatDate(post.data.date)} - {wordCount(post.body)} words</p>
      </li>
    ))}
  </ul>
</Base>
