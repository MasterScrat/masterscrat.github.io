---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { getPosts, postUrl, formatDate, excerpt } from '../lib/posts';

const posts = await getPosts();
---
<Base title="Blog">
  <div class="tiles">
    {posts.map((post) => (
      <Tile draft={post.data.draft} kind="Post" href={postUrl(post)} title={post.data.title}
            meta={post.data.draft ? `${formatDate(post.data.date)} · DRAFT` : formatDate(post.data.date)}
            text={excerpt(post)} image={post.data.image} />
    ))}
  </div>
</Base>
