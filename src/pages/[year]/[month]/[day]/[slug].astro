---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getPosts, postParams, formatDate, excerpt, type Post } from '../../../../lib/posts';
import { linkAttrs } from '../../../../lib/links';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: postParams(post), props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
// `?? []`: a dev server started before `links` existed has cached entries without it.
const links = post.data.links ?? [];
// "Originally published on Medium ↗" for posts first published elsewhere.
const original = post.data.original;
const SITES: Record<string, string> = { 'medium.com': 'Medium', 'hackernoon.com': 'HackerNoon' };
const originalSite = original
  ? (SITES[new URL(original).hostname.replace(/^www\./, '')] ?? new URL(original).hostname.replace(/^www\./, ''))
  : undefined;
---
<Base title={post.data.title} description={excerpt(post)} image={post.data.image} jsonld={{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: post.data.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'Florian Laurent', url: 'https://florianlau.rent/' },
  ...(post.data.image && { image: new URL(post.data.image, Astro.site).href }),
}}>
  <article class="page">
    <hgroup>
      <h1>{post.data.title}</h1>
      <p>
        {formatDate(post.data.date)}
        {original && <> · Originally published on <a href={original} {...linkAttrs(original)}>{originalSite} ↗</a></>}
      </p>
    </hgroup>
    {links.length > 0 && (
      <p class="page-links">
        {links.map((l) => <a href={l.url} class="button" {...linkAttrs(l.url)}>{l.label}</a>)}
      </p>
    )}
    {post.data.image && post.data.cover !== false && <img class="page-cover" src={post.data.image} alt="" />}
    <div class="prose">
      <Content />
      <p><a href="/blog/">← All posts</a></p>
    </div>
  </article>
</Base>
