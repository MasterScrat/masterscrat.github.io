---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getPosts, postParams, formatDate, excerpt, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: postParams(post), props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
---
<Base title={post.data.title} description={excerpt(post)} image={post.data.image}>
  <article class="prose">
    <hgroup>
      <h1>{post.data.title}</h1>
      <p>{formatDate(post.data.date)}</p>
    </hgroup>
    {post.data.image && post.data.cover !== false && <img class="cover" src={post.data.image} alt="" />}
    <Content />
    <p><a href="/blog">← All posts</a></p>
  </article>
</Base>
