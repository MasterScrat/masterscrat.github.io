---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, type Project } from '../../lib/projects';
import { linkAttrs } from '../../lib/links';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, links, image, cover } = project.data;
const { Content } = await render(project);
---
<Base title={title} description={summary} image={image}>
  <article class="page">
    <h1>{title}</h1>
    {links.length > 0 && (
      <p class="page-links">
        {links.map((l) => <a href={l.url} class="button" {...linkAttrs(l.url)}>{l.label}</a>)}
      </p>
    )}
    {image && cover !== false && <img class="page-cover" src={image} alt="" />}
    <div class="prose">
      <Content />
      <p><a href="/projects/">← All projects</a></p>
    </div>
  </article>
</Base>
