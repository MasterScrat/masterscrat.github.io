---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { title, summary, years, role, links, image } = project.data;
const { Content } = await render(project);
---
<Base title={title} description={summary}>
  <article class="prose">
    <hgroup>
      <h1>{title}</h1>
      <p>{summary}</p>
    </hgroup>
    <p class="meta">{[years, role].filter(Boolean).join(' · ')}</p>
    {links.length > 0 && (
      <p class="project-links">
        {links.map((l) => <a href={l.url} class="button">{l.label}</a>)}
      </p>
    )}
    {image && <img src={image} alt="" />}
    <Content />
    <p><a href="/projects/">← All projects</a></p>
  </article>
</Base>
