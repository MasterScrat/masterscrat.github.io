---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { getPosts, postUrl, formatDate, excerpt } from '../lib/posts';
import { getProjects, projectUrl } from '../lib/projects';

const featured = (await getProjects()).filter((p) => p.data.featured);
const recent = (await getPosts()).slice(0, 4);

const projectTiles = featured.map((p) => ({
  kind: 'Project' as const, href: projectUrl(p), title: p.data.title,
  meta: p.data.years, text: p.data.summary, image: p.data.image,
}));
const postTiles = recent.map((p) => ({
  kind: 'Post' as const, href: postUrl(p), title: p.data.title,
  meta: formatDate(p.data.date), text: excerpt(p),
}));
// Alternate project / post tiles.
const tiles = Array.from({ length: Math.max(projectTiles.length, postTiles.length) })
  .flatMap((_, i) => [projectTiles[i], postTiles[i]])
  .filter(Boolean);
---
<Base>
  <section class="intro">
    <img src="/img/florian-laurent.jpg" alt="Florian Laurent" class="avatar" />
    <div>
      <h1>Florian Laurent</h1>
      <p>
        Hey there! I'm Florian, a Machine Learning engineer and entrepreneur. I work on Generative AI
        and Reinforcement Learning. I'm based in French-speaking Switzerland.
      </p>
      <p>[TODO write what I'm up to right now] <a href="/about">More about me →</a></p>
    </div>
  </section>

  <section>
    <div class="tiles">
      {tiles.map((t) => <Tile {...t} />)}
    </div>
    <nav>
      <ul>
        <li><a href="/projects/">All projects →</a></li>
        <li><a href="/blog">All posts →</a></li>
      </ul>
    </nav>
  </section>
</Base>
