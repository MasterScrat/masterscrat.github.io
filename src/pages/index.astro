---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { getEntry } from 'astro:content';
import { postUrl, formatDate, excerpt } from '../lib/posts';
import { projectUrl } from '../lib/projects';

// Tiles shown on Home, in order: project ids (file names in src/content/projects/)
// or post ids (file names in src/content/posts/).
const featured = [
  ['projects', 'general-intuition'],
  ['projects', 'dreamlook'],
  ['projects', 'cedille'],
  ['projects', 'ariane'],
  ['posts', '2014-10-13-lemans-shores-timelapse-around-the-lake'],
  ['projects', 'chatistics'],
] as const;

const tiles = await Promise.all(featured.map(async ([collection, id]) => {
  const entry = await getEntry(collection, id);
  if (!entry) throw new Error(`Featured tile not found: ${collection}/${id}`);
  return entry.collection === 'projects'
    ? { kind: 'Project' as const, href: projectUrl(entry), title: entry.data.title,
        meta: entry.data.years, text: entry.data.summary, image: entry.data.image }
    : { kind: 'Post' as const, href: postUrl(entry), title: entry.data.title,
        meta: formatDate(entry.data.date), text: excerpt(entry) };
}));
---
<Base>
  <section class="intro">
    <img src="/img/florian-laurent.jpg" alt="Florian Laurent" class="avatar" />
    <div>
      <p>
        Hey there! I'm Florian, a Machine Learning engineer and entrepreneur. I work on Generative AI
        and Reinforcement Learning. I'm based in French-speaking Switzerland.
      </p>
      <SocialIcons />
      <p>[TODO write what I'm up to right now] <a href="/about">More about me →</a></p>
    </div>
  </section>

  <section>
    <div class="tiles">
      {tiles.map((t) => <Tile {...t} />)}
    </div>
    <p class="more">
      <a href="/projects/" class="button">All projects</a>
      <a href="/blog" class="button">All posts</a>
    </p>
  </section>
</Base>
