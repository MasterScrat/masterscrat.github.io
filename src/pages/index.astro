---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { getPosts, postUrl, formatDate, excerpt } from '../lib/posts';
import { getProjects, projectUrl } from '../lib/projects';

const featured = (await getProjects()).filter((p) => p.data.featured);
const recent = (await getPosts()).slice(0, 4);

const projectTiles = featured.map((p) => ({
  kind: 'Project' as const, href: projectUrl(p), title: p.data.title,
  meta: p.data.years, text: p.data.summary, image: p.data.image,
}));
const postTiles = recent.map((p) => ({
  kind: 'Post' as const, href: postUrl(p), title: p.data.title,
  meta: formatDate(p.data.date), text: excerpt(p),
}));
// Alternate project / post tiles.
const tiles = Array.from({ length: Math.max(projectTiles.length, postTiles.length) })
  .flatMap((_, i) => [projectTiles[i], postTiles[i]])
  .filter(Boolean);
---
<Base>
  <section class="intro">
    <img src="/img/florian-laurent.jpg" alt="Florian Laurent" class="avatar" />
    <div>
      <h1>Hi, I'm Florian.</h1>
      <p>
        I'm a machine learning engineer and entrepreneur based in French-speaking Switzerland.
        I work on generative AI and reinforcement learning, and over the years I've trained
        large language models, built ML tooling startups, and run research on RL for railways.
      </p>
      <p>
        Right now I'm a founding member of <a href="/projects/general-intuition">General Intuition</a>,
        a research lab dedicated to video games and beyond. I also co-founded NyxAI, the company
        behind <a href="/projects/dreamlook">dreamlook.ai</a>. <a href="/about">More about me →</a>
      </p>
    </div>
  </section>

  <section>
    <div class="tiles">
      {tiles.map((t) => <Tile {...t} />)}
    </div>
    <p class="more-links">
      <a href="/projects/">All projects →</a>
      <a href="/blog">All posts →</a>
    </p>
  </section>
</Base>
